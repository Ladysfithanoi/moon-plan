# ─── Supabase ────────────────────────────────────────────────────────────────
# Lấy ở Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# service_role key — CHỈ dùng phía server. Không bao giờ đặt tiền tố NEXT_PUBLIC_.
# Toàn bộ luật chơi (điểm, streak, Ngày Thỏ Ngọc, hộp quà) chạy bằng key này ở server.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Phiên đăng nhập ─────────────────────────────────────────────────────────
# Chuỗi ngẫu nhiên ≥32 ký tự, dùng để ký cookie phiên.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Mật khẩu vào trang admin của Trung
ADMIN_PASSWORD=doi-mat-khau-nay

# ─── Tuỳ chọn ────────────────────────────────────────────────────────────────
# Đổi ngày "hôm nay" khi cần thử nghiệm trước/sau sự kiện (định dạng YYYY-MM-DD).
# Để trống khi chạy thật.
EVENT_DATE_OVERRIDE=
